# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
xcuserdata/
*.moved-aside
*.pbxuser
!default.pbxuser
*.perspectivev3
!default.perspectivev3

# Generated Xcode project: source of truth is project.yml (XcodeGen).
# Regenerate with `xcodegen generate` (or it runs inside build-and-install.sh).
*.xcodeproj

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# CocoaPods / Carthage (only if introduced later)
Pods/
Carthage/Build/

# Fastlane (only if introduced later)
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets - never commit API keys
*.xcconfig.local
Secrets.plist
.env
.env.*

# Internal design and decision docs live outside the public repo; ignored so they can't creep back.
docs/

# Generated by xcodegen from project.yml, same as the .xcodeproj above. Checking these
# in would fight regeneration: the generator rewrites them on every run.
NockerlVoice/Info.plist
NockerlVoice/NockerlVoice.entitlements

# Python bytecode. scripts/verify-cloud-models.py is run directly, never imported,
# so these are pure build residue. One got committed because a pre-merge syntax check
# compiled the script and a broad `git add` swept the artefact in with the real work.
__pycache__/
*.pyc
